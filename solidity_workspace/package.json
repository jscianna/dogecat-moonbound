{
    "name": "solidity-workspace",
    "version": "1.0.0",
    "scripts": {
        "build": "hardhat compile",
        "test": "hardhat test --no-compile",
        "ledger:check": "hardhat run --no-compile scripts/ledger-check.js --network dogeosTestnet",
        "deploy:dogeos": "hardhat run --no-compile scripts/deploy.js --network dogeosTestnet",
        "roles:verify": "hardhat run --no-compile scripts/verify-roles.js --network dogeosTestnet",
        "minter:grant": "hardhat run --no-compile scripts/grant-minter.js --network dogeosTestnet",
        "minter:revoke": "hardhat run --no-compile scripts/revoke-minter.js --network dogeosTestnet",
        "mint:test": "hardhat run --no-compile scripts/test-mint.js --network dogeosTestnet",
        "cap:set": "hardhat run --no-compile scripts/set-mint-cap.js --network dogeosTestnet",
        "mint:pause": "hardhat run --no-compile scripts/pause.js --network dogeosTestnet"
    },
    "devDependencies": {
        "@nomicfoundation/hardhat-chai-matchers": "2.0.8",
        "@nomicfoundation/hardhat-ethers": "3.0.8",
        "@nomicfoundation/hardhat-ignition": "0.15.10",
        "@nomicfoundation/hardhat-ignition-ethers": "0.15.10",
        "@nomicfoundation/hardhat-ledger": "1.1.0",
        "@nomicfoundation/hardhat-network-helpers": "1.0.12",
        "@nomicfoundation/hardhat-toolbox": "5.0.0",
        "@nomicfoundation/hardhat-verify": "2.0.13",
        "@openzeppelin/contracts": "4.9.6",
        "@typechain/ethers-v6": "0.5.1",
        "@typechain/hardhat": "9.1.0",
        "@types/chai": "4.3.20",
        "@types/mocha": "10.0.10",
        "@types/node": "22.10.0",
        "chai": "4.5.0",
        "ethers": "6.13.4",
        "hardhat": "2.22.17",
        "hardhat-gas-reporter": "1.0.10",
        "solidity-coverage": "0.8.14",
        "ts-node": "10.9.2",
        "typechain": "8.3.2",
        "typescript": "5.7.2"
    }
}
